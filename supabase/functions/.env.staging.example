# ====================================================================
# HARIT JAL™ (हरित जल) — SUPABASE EDGE FUNCTIONS STAGING SECRETS TEMPLATE
# NEVER commit `supabase/functions/.env.staging` to version control.
# Covers all 4 Edge Functions:
#   1. staff-auth
#   2. validate-admin-route
#   3. send-email-otp
#   4. crm-sync
# Deploy to Staging Supabase Cloud with:
#   supabase secrets set --env-file supabase/functions/.env.staging --project-ref <STAGING_PROJECT_REF>
# WARNING: NEVER DEPLOY THIS FILE AGAINST PRODUCTION (doqzleqcyuymqyfjemcr)!
# ====================================================================

# 1. SUPABASE SERVICE-ROLE CLIENT (Automatically injected by Supabase Cloud)
# Required for edge rate-limiting RPCs, otp_challenges persistence, and staff lifecycle:
# SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key

# 2. TRANSACTIONAL EMAIL DELIVERY (Resend Sandbox / Staging Key)
# Use a dedicated staging API key or domain tag restricted to @test.haritjal.in:
RESEND_API_KEY=re_staging_test_api_key_placeholder
RESEND_FROM_EMAIL=Harit Jal Staging <noreply@test.haritjal.in>
HARIT_JAL_ADMIN_EMAIL=staging.admin@test.haritjal.in

# 3. DEDICATED OTP CHALLENGE HMAC SIGNING SECRET (Distinct 256-Bit Secret)
# Generate via: openssl rand -hex 32
OTP_SIGNING_SECRET=replace_with_distinct_staging_64_char_hex_secret

# 4. GOOGLE SHEETS STAGING CRM WEBHOOK (Isolated Staging Google Sheet)
# Target a dedicated staging spreadsheet / tab (e.g. HaritJal_Inquiries_Staging):
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/STAGING_DEPLOYED_SCRIPT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_staging_32_char_random_webhook_secret

# 5. BOT DEFENSE TESTING (Cloudflare Turnstile Always-Pass Testing Secret)
# Official Cloudflare test secret key that always validates successfully:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 6. OPTIONAL CLOUD LLM PROXY (Staging Developer Quota or Mock)
GEMINI_API_KEY=
NEER_AI_DAILY_LIMIT=100

# 7. ALLOWED BROWSER CORS ORIGINS (Staging & Local Dev Only)
ALLOWED_ORIGINS=https://staging.haritjal.in,http://localhost:5173,http://127.0.0.1:5173

# 8. PUBLIC SITE & LOGO URL
EMAIL_LOGO_URL=https://staging.haritjal.in/images/haritjal_logo_gold_trans.png
PUBLIC_SITE_URL=https://staging.haritjal.in
APP_ENV=staging
