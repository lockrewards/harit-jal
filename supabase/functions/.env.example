# ====================================================================
# HARIT JAL™ (हरित जल) — SUPABASE EDGE FUNCTIONS SERVER SECRETS TEMPLATE
# NEVER commit `supabase/functions/.env` to version control.
# Covers all 4 Edge Functions:
#   1. staff-auth
#   2. validate-admin-route
#   3. send-email-otp
#   4. crm-sync
# Deploy to Supabase Cloud with:
#   supabase secrets set --env-file supabase/functions/.env --project-ref doqzleqcyuymqyfjemcr
# ====================================================================

# 1. SUPABASE SERVICE-ROLE CLIENT (Automatically injected by Supabase Cloud)
# Required for edge rate-limiting RPCs, otp_challenges persistence, and staff lifecycle:
# SUPABASE_URL=https://doqzleqcyuymqyfjemcr.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 2. TRANSACTIONAL EMAIL DELIVERY (Resend API — Server-Only)
# Generate at https://resend.com -> API Keys -> Sending Access
RESEND_API_KEY=re_your_server_side_resend_api_key
RESEND_FROM_EMAIL=Harit Jal <noreply@haritjal.in>
HARIT_JAL_ADMIN_EMAIL=info@haritjal.in

# 3. OTP CHALLENGE HMAC SIGNING SECRET (32+ random hex/base64 characters, >= 256 bits)
# Generate primary secret via: openssl rand -hex 32
OTP_SIGNING_SECRET=replace_with_64_char_random_hex_secret
# Optional key rotation secret (must also have >= 32 bytes of entropy if specified)
# OTP_SIGNING_SECRET_PREVIOUS=

# 4. GOOGLE SHEETS CRM WEBHOOK (Server-Only Proxy via crm-sync Edge Function)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYED_SCRIPT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_32_char_random_webhook_secret

# 5. BOT DEFENSE & RATE LIMITING (Cloudflare Turnstile)
# Production Turnstile Secret Key (Generated in Cloudflare Turnstile dashboard; test secrets forbidden in production)
TURNSTILE_SECRET_KEY=

# 6. OPTIONAL CLOUD LLM PROXY & DAILY QUOTA (Server-Only via crm-sync Edge Function)
GEMINI_API_KEY=
NEER_AI_DAILY_LIMIT=250

# 7. ALLOWED BROWSER CORS ORIGINS (Comma-Separated)
ALLOWED_ORIGINS=https://haritjal.in,https://www.haritjal.in

# 8. ENVIRONMENT MODE (production | staging | development | test)
APP_ENV=production

