VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_anon_key_placeholder...

# 2. PUBLIC APPLICATION METADATA (Staging Target)
VITE_SITE_URL=https://staging.haritjal.in
