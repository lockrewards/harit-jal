# ====================================================================
# HARIT JAL™ (हरित जल) — FRONTEND PUBLIC ENVIRONMENT TEMPLATE
# SECURITY NOTICE:
#   Vite embeds EVERY `VITE_*` variable into the public browser bundle.
#   NEVER place API secrets, Resend keys, Gemini keys, webhook secrets,
#   or Supabase `service_role` keys in this file or with a `VITE_` prefix!
#   Server secrets belong strictly in Supabase Edge Function Secrets
#   (`supabase/functions/.env` locally or `supabase secrets set` in cloud).
# ====================================================================

# 1. PUBLIC SUPABASE CLIENT CONFIGURATION (RLS Protected)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. PUBLIC APPLICATION METADATA
VITE_SITE_URL=https://haritjal.in
VITE_APP_ENV=production
