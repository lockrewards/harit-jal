# ====================================================================
# HARIT JAL™ (हरित जल) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your production credentials
# ====================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. RESEND TRANSACTIONAL EMAIL SERVICE (OTP, PASSWORD RESETS, BOOKING CONFIRMATIONS)
# Sign up at https://resend.com -> API Keys -> Create API Key (starts with re_)
# Free tier gives 100 emails/day and 3,000 emails/month
VITE_RESEND_API_KEY=re_123456789_abcdefg
# If domain is not verified yet, use Resend's free testing sender:
VITE_RESEND_FROM_EMAIL=Harit Jal™ <onboarding@resend.dev>
# Once your custom domain (e.g. haritjal.in) is verified in Resend:
# VITE_RESEND_FROM_EMAIL=Harit Jal Concierge <noreply@haritjal.in>

# 3. GOOGLE GEMINI AI (OPTIONAL CLOUD LLM FOR NEER AI)
# If empty, Neer AI uses the fast, built-in local intelligent RAG engine
VITE_GEMINI_API_KEY=

# 3. GOOGLE SHEETS WEBHOOK (OPTIONAL REAL-TIME CRM SYNC)
# Google Apps Script Web App URL for automated lead capture spreadsheet
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# 4. STATUTORY & DOMAIN CONFIGURATION
VITE_SITE_URL=https://haritjal.in
VITE_APP_ENV=production

